# ==============================================================================
# ElderCare AI Environment Configuration Template
# ==============================================================================

# MongoDB Connection String (Local MongoDB Daemon or Atlas Cluster)
MONGODB_URI=mongodb://localhost:27017/eldercare_db
MONGODB_DATABASE=eldercare_db

# Backend Java Server Port
PORT=8088

# Python Voice AI Service Port
VOICE_AI_PORT=8092

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8088/api

# SNS Agent Workbench Webhook URL (External Visual Workflow Trigger)
VITE_SNS_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook-test/eldercare-events

# Supabase Cloud Database & Realtime (PostgreSQL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key for Multilingual Voice Recognition & AI Companion (English, Tamil, Malayalam)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
